{
    "name": "scorp-sk/rpo",
    "description": "Live clone of the Slovak Register of Legal Entities (RPO) with a REST API on top of your own MariaDB",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-pdo_mysql": "*",
        "ext-zlib": "*",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "nikic/fast-route": "^1.3",
        "symfony/console": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Rpo\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
